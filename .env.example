# Telegram API Configuration (Required)
# Get these from https://my.telegram.org/auth
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890
TG_PHONE=+1234567890

# Telegram Bot Token (Required for inline buttons)
BOT_TOKEN=

# Telegram Session File (Optional)
TG_SESSION_FILE=team_records_bot.session

# Google Sheets Configuration (Required)
# Spreadsheet ID from the URL: docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/
SHEETS_ID=1rkgRG95lxUgeplceekMY3Z_NZIBKxjTKNwLSpw04xgQ
SHEETS_TITLE=Team Records

# Google Service Account (Required)
# Path to the service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Database Configuration (Optional)
DB_PATH=team_records.db

# Admin Configuration (Optional)
# Comma-separated list of Telegram chat IDs for admins
ADMIN_CHAT_IDS=123456789,987654321
MANAGER_CHAT_IDS=111111111,222222222

# Proxy Configuration (Optional)
# Uncomment if using SOCKS5 proxy (e.g., for Tor)
# PROXY_HOST=127.0.0.1
# PROXY_PORT=9050

# Obsidian REST API (Optional — for second brain integration)
# URL should point to the team workspace vault, not personal vault
OBSIDIAN_URL=http://localhost:27123
OBSIDIAN_API_KEY=

# Ollama Embeddings (Optional — for RAG search)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Bot Behavior Configuration (Optional)
# DAILY_REPORT_TIME=18:00
# LOOP_INTERVAL=5.0
# SYNC_INTERVAL=3600
# REMINDER_CHECK_INTERVAL=300
