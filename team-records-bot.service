[Unit]
Description=Team Records Telegram Bot (Ralph Loop)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=baiwan
Group=baiwan
WorkingDirectory=/home/baiwan/team-records-bot
EnvironmentFile=/home/baiwan/team-records-bot/.env
ExecStartPre=/usr/bin/docker start tor-proxy
ExecStart=/home/baiwan/team-records-bot/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
